#!/bin/sh
# 提交前体检（T0.2）。由 `python tools/hooks/install_hooks.py` 装进 .git/hooks/。
#
# 只跑「与本次改动相关 + 上一轮实测很快」的那批（`selfcheck.py --fast`），
# 预算 90 秒：**超了只警告，不把人堵在门外**。
#
# 为什么要有这一步：147 个测试文件散着，谁也不会在提交前手工跑一遍；
# 而「改坏一行」这类事故的代价，是等出片链跑到一半才发现。
# 为什么不是全量：全量约 15~20 分钟，放提交前的结果是所有人都加 `--no-verify`。
set -u

cd "$(git rev-parse --show-toplevel)" || exit 0

# 优先用能 import pytest 的那个解释器：`selfcheck.py` 内部用 `sys.executable -m pytest`。
PY="${SELFCHECK_PYTHON:-}"
if [ -z "$PY" ]; then
  for cand in python3 python py; do
    if command -v "$cand" >/dev/null 2>&1; then PY="$cand"; break; fi
  done
fi
if [ -z "$PY" ]; then
  echo "[pre-commit] 找不到 python，跳过体检"
  exit 0
fi

start=$(date +%s)
SELFCHECK_HOOK_BUDGET="${SELFCHECK_HOOK_BUDGET:-90}" "$PY" selfcheck.py --fast
rc=$?
elapsed=$(( $(date +%s) - start ))

if [ "$rc" -ne 0 ]; then
  echo ""
  echo "[pre-commit] 体检有红，提交被拦下。"
  echo "  逐条看：python selfcheck.py --only <文件名里的关键词>"
  echo "  确认是既有问题、与本次改动无关：git commit --no-verify（请说明原因）"
  exit 1
fi

if [ "$elapsed" -gt 90 ]; then
  echo "[pre-commit] 体检用了 ${elapsed}s（预算 90s）——只做了快速拦阻，全量请跑 python selfcheck.py"
fi
exit 0
