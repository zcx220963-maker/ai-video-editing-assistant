# 上线存储层配置模板：复制为 .env 后填值（.env 不入库、不打印、不写日志）。
# 五项全部由 agent_framework/storage/__init__.py 从环境变量读取，代码里不写死。
#
#   copy .env.example .env        （Windows）
#   cp .env.example .env          （*nix）
#
# 与 docker-compose.yml 的默认凭证一致，本机起容器后可直接用。

# PostgreSQL：asyncpg 方言。 SQLAlchemy 会自动补 +asyncpg，也可写全。
PG_DSN=postgresql://creation:creation_dev_pw@127.0.0.1:5432/creation

# MinIO：endpoint 只写 host:port（不带 http://），secure=0 表示本机 HTTP
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=creationdev
MINIO_SECRET_KEY=creation_dev_pw_8chars
MINIO_BUCKET=creation-assets

# 可选：MinIO 是否走 HTTPS（1/true/yes），以及 PG 连接池大小
MINIO_SECURE=0
PG_POOL_SIZE=5
# 可选：池的三条补充参数，不改也能跑（默认值就是这里写的）
#   PG_POOL_MAX_OVERFLOW —— 池满时允许再多开几条：长任务（渲染代查、批量转写）与
#     HTTP handler 共用这一池，排队等下一轮超时不如溢出几条。
#   PG_POOL_PRE_PING —— 取连接前先 ping 一下（1/true/yes 为开）。容器重启或 PG 侧
#     掐掉空闲连接后，池里那条是死的，不 ping 就是一次 StorageUnavailable。
#   PG_POOL_RECYCLE_SEC —— 连接活够这么久就换新，别等它被中间层掐了才发现。
PG_POOL_MAX_OVERFLOW=10
PG_POOL_PRE_PING=1
PG_POOL_RECYCLE_SEC=1800

# docker compose 用的分量（改了这里就要同步改 PG_DSN / MINIO_*）
PG_USER=creation
PG_PASSWORD=creation_dev_pw
PG_DB=creation

# 可选：把模型的思考模式打开。deepseek-flash 是思考型模型，默认**关**（实测文本快 2.1×、
# 带图快 1.7×，答复质量没退化）。只有确实要长推理的任务才开，开了每轮都多写一段 reasoning。
OPENAI_THINKING=off
# 剪辑侧画面理解的同一开关在 examples/storyline/config.toml → [capabilities] vl_thinking

# 模型密钥：**只需这一把**。日常不用填在这里——页面右上「设置」里填一次即可，
# 值写进 PG `app_secrets`，:8000 与 :8001 每次请求前热读（不用重启两个进程）。
# 这一行是第二层回落：无头部署、CI、以及还没打开过页面的时候用。
# 解析顺序：前端配置 → 本变量 → llm_openai.py 的进程内回落位。
# 视觉理解（默认 deepseek-flash）与文案共用同一把 key —— 一个 key 用到底；
# 只有把 examples/storyline/config.toml 的 vl_base 指向别家服务商时才需要第二个。
OPENAI_API_KEY=
# 可选：上面这把没填时的同层回落位（历史名字，现在确实被代码读取：按
# OPENAI_API_KEY → DEEPSEEK_API_KEY → SILICONFLOW_API_KEY 的顺序取第一把非空的）。
# 三者是**同一层的三个名字**，不是三把不同的 key——日常仍然只在页面「设置」里填一把。
DEEPSEEK_API_KEY=
SILICONFLOW_API_KEY=

# 按链接取素材（yt-dlp 兜底）的两项，都不设也能跑：
# YTDLP_JS_RUNTIMES —— YouTube 的签名/n 挑战要一个 JS 运行时。不设就按 PATH 探测
#   deno / node / quickjs / bun（本机已有 Node ≥22 就直接可用）；要钉死路径写
#   `node:D:/nvm/node.exe`，多个用逗号或分号分隔。
# YTDLP_COOKIES_FILE —— 需要登录态的站点：**只写浏览器导出 cookie 的文件路径**，
#   cookie 值本身不进这里、不进代码、不进日志、不进 PG。
YTDLP_JS_RUNTIMES=
YTDLP_COOKIES_FILE=
