{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowJs": true,
    "baseUrl": ".",
    "paths": {
      "@dg/film": ["src/FilmLayout.tsx"],
      "@dg/tokens": ["src/tokens.ts"],
      "@dg/motion": ["src/demos/_fixtures/Motion.tsx"],
      "@dg/polish": ["src/demos/_fixtures/Polish.tsx"],
      "@dg/brand": ["src/demos/_fixtures/Brand.tsx"],
      "@dg/fixtures/*": ["src/demos/_fixtures/*"],
      "@dg/lib/*": ["src/lib/*"],
      "@dg/themes/*": ["src/themes/*"],
      "@dg/demos/*": ["src/demos/*"]
    }
  },
  "include": ["src"]
}
