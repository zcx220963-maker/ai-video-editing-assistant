# ---- 密钥与本地配置：绝不入库 ----
# .env 里有真实的 PG 密码与 MinIO secret key。曾经差点被提交——先排除再 add。
.env
.env.local
.env.*.local
# 历史遗留：明文 token（见审计报告）
.runtime/legacy-credentials.txt
*.pem
*.key

# ---- 运行时数据（4 GB 级，全部可再生）----
# 剪辑产物缓存与工作区
.storyline/
# 审计脚本与中间产物（探针日志、下载回来的音视频、报告）
.runtime/
# 临时目录
.tmp/
# 本地日志
*.log
.main_server.log
.storyline_server.log
server.log
storyline_err.log
debug_confirm.log
nul

# 本地快照/状态文件
.merkle-snapshot.json

# ---- 依赖与构建产物 ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
frontend/node_modules/
frontend/dist/
# creation-remotion：npm ci 出来的 297 个包，权威是 package-lock.json
remotion/node_modules/
# 渲染服务按 cache_key 自己堆的切片目录（本机预检也写这里），入库等于把缓存当源码
remotion/out/

# ---- 离线依赖包（体积大，且 requirements*.txt 才是权威）----
*.whl

# ---- 编辑器/工具 ----
.codeartsdoer/
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# ---- 测试与覆盖率 ----
.pytest_cache/
.coverage
htmlcov/

# ---- 个人笔记:本地保留,不入库 ----
docs/面试复习全解.md
docs/项目复习指南.md

# ---- backend 本地开发件(不入库) ----
backend/tests/
backend/docs/
backend/scripts/
backend/.smoke/
# 仓库根那一份同样是取证残渣（真渲样片 mp4 + 一次性探针脚本），不是源码
.smoke/
# 仓库根的临时截图与渲染产物（不入库）
tmp_*.jpg
tmp_*.png
motion_final.mp4
# remotion 下的临时标定脚本与归档重复夹具
remotion/.tmp_*
remotion/_archive/
backend/pytest.ini
backend/start.bat

# ---- 本地参考件与别的 CLI 的配置（不入库）----
# OpenChatCut 已从本项目摘除（compose 里没有它的服务，构建它的 Dockerfile 也删了），
# 当初留在本地翻代码的那份上游克隆也已删除；这条规则留着，是为了以后再克隆回来时仍不入库
openchatcut-src/
# 另一个 CLI 的忽略文件，内容由本文件同步出去，再入库就是两份互相抄
.zcodeignore

# ---- 会话内草稿与外部 agent 状态（2026-10-15 收口：推送前最后一次扫剩的全是这类）----
# 一次性探针/取证产物：_gate_out.txt、_tsc_*.txt、remotion/_curve.mjs 这类根目录或 remotion 直下划线开头文件
/_*.*
/remotion/_*.*
# 会话临时目录与脚本副本：.tmp_b24/、.tmp_recovered_shots/、backend/.tmp_args.py
.tmp_*
# 并行外部 agent（workbuddy）留在工作树里的状态文件
/.wb*
/.workbuddy-ai/

# 抽帧验证的一次性产物（f228529 混入库，全项目零引用）
/video_frames/

# ---- 交付残渣与内部合同文档（本地保留，不随库分发）----
# 落地报告/对比截图是一次性验收产物，README 与代码都不引用它们
/outputs/
# 开发合同与其增补卷：全项目零代码引用，是给人看的内部文档
/REMOVIDE_*.md

# ---- 启动用不到的部分（2026-10-15：仓库只留「克隆下来能构建、能启动」所需的文件）----
# 文档：README 之外的设计文档本地保留
/docs/
# 素材入库与巡检脚本、素材供给探活记录：运行时代码与镜像都不用它们
/scripts/
/assets/
# remotion 示例镜头：后端用的是技能语料里那一份（backend/examples/skills/motion_explainer/demos），
# 渲染时镜头代码只能经别名引到 _fixtures/、lib/、themes/——其余 demo 目录运行时一个都不读
/remotion/src/demos/*
!/remotion/src/demos/_fixtures/
# remotion 测试：镜像构建期只跑下面放回来的四件（见 remotion/Dockerfile），其余是探针与本地夹具
/remotion/tests/*
!/remotion/tests/gate1-lint.mjs
!/remotion/tests/gate13-assets.mjs
!/remotion/tests/fixtures-gate13.mjs
!/remotion/tests/shipped-namespace.mjs
/remotion/src/user-shots/fixture-*.tsx
/remotion/src/lib/helpers/__tests__/
